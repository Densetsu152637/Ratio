// The `state` built-ins are typed by the package's declaration, never by the caller: untrusted
// state cannot be read back as trusted text, a turbofish cannot choose another type, a value
// of another type cannot be stored, and the built-ins cannot be used as function values (whose
// expected type would choose the type instead).

state: { note: Untrusted<Str> } = { note: "" }

fn as_trusted() -> Str {
  let s: { note: Str } = state.get()
  s.note
}

fn chosen() -> Str {
  state.get::<{ note: Str }>().note
}

fn wrong() -> () {
  state.set({ note: 1 })
}

fn as_value() -> () {
  let get = state.get
}

fn through_update() -> Str {
  state.update(|s| { note: "fixed" }).note
}
