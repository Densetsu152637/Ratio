// expect: check-error C0035 at 9:13
// expect: check-error C0035 at 10:26

// Untrusted text on either side of an `example` (few-shot pairs are instructions).

fn ask(sample: Untrusted<Str>, task: TaskInput) -> Prompt {
  prompt {
    instruct "Classify."
    example sample -> "positive"
    example "neutral" -> task.brief
  }
}
