// A generic function that may reach a secrecy sink, instantiated at a type holding a secret,
// is refused however it is instantiated: called, named at an expected function type,
// instantiated by a turbofish, or returned. A secrecy sink is any effect that is not kept on
// the machine: the network, a model (it may be hosted), `session.emit`, any tool.

fn tok() -> Secret<UserText> {
  let a = session.ask([{ question: "Password?", options: [], recommended: "", secret: true }])
  a[0]
}

fn send<T>(x: T) -> () {
  let _ = tools.web_fetch("{x}")
}

fn apply<A, B>(f: fn(A) -> B, a: A) -> B {
  f(a)
}

fn annotated() -> () {
  let f: fn(Secret<UserText>) -> () = send
  f(tok())
}

fn turbofish() -> () {
  apply::<Secret<UserText>, ()>(send, tok())
}

fn sender() -> fn(Secret<UserText>) -> () {
  send
}

fn emit<T>(x: T) -> () {
  session.emit("event", json.parse("{x}"))
}

fn emitted() -> () {
  emit(tok())
}

fn ask_model<T>(x: T) -> Untrusted<Str> {
  model.generate(prompt { data "{x}" as "x" })
}

fn modelled() -> () {
  let _ = ask_model(tok())
}

fn reads_only<T>(x: T) -> Int {
  let f = tools.read_file("notes.md")
  f.total_lines
}

fn local_is_fine() -> () {
  let _ = reads_only(tok())
}
