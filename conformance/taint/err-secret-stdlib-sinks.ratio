// A statically secret value (`session.ask` with `secret: true`) reaches no secrecy sink of the
// effectful modules: delegation, memory, eval records, the session's clients and new sessions,
// the browser, media, MCP, scripts, extensions and authored harnesses. A generic function that
// may reach a sink cannot be instantiated at a secret either: its body cannot see the label.

fn token() -> Secret<UserText> {
  let answers = session.ask([{ question: "Token?", options: [], recommended: "", secret: true }])
  answers[0]
}

fn delegation(task: Task<Report>) -> () {
  let t = token()
  let a = agents.delegate(t)
  let b = agents.map([t])
  let c = agents.resume(task, t)
  let d = agents.keep_as_knowledge(task, t)
}

fn memory_writes(name: Untrusted<Str>) -> () {
  let t = token()
  let hits = memory.search(t)
  memory.edit(name, "old", t)
  memory.forget(t)
}

fn records() -> () {
  let t = token()
  eval.label("token", t)
  eval.score("s", 1.0, reason: t)
  let same = eval.golden("token", t)
  let report = eval.run_tests(t)
}

fn people_and_sessions() -> () {
  let t = token()
  session.notify(t)
  session.stream(t)
  let cp = session.checkpoint(label: t)
  let s = session.start(t)
}

fn outbound() -> () {
  let t = token()
  let page = tools.browser_open(t)
  let typed = tools.browser_type("#password", t)
  let image = tools.media_image(t)
  let resource = tools.mcp_read_resource("docs", t)
  let script = tools.run_script(t)
  tools.install_extension(skill, t)
  tools.set_model_card("local-small", t)
  let v = meta.author("leak", t, "a harness")
}

fn announce<T>(x: T) -> () {
  session.notify("{x}")
}

fn generic() -> () {
  announce(token())
}

// Generic sinks: the parameter's type admits the secret, so the refusal is `@secrecy_sink`'s
// own (its message names the sink). `model.count_tokens` counts text, prompts and
// conversations only, and a secret is none of them.
fn generic_sinks() -> () {
  let t = token()
  let c = think.consensus([t, t])
  let r = model.rank([t], show: |x| "item", criteria: "best")
  let n = model.count_tokens(t)
}
