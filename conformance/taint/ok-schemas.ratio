// expect: check-ok

// Schema-able types: scalars, text, options, lists, tuples, records, maps, enums and `Json`,
// with descriptions and refinements on record fields.

enum Severity { low, medium, high }

enum Finding { Bug { line: Int, why: Str }, Style { note: Str }, Clean }

type Report = {
  /// What the reviewer concluded.
  verdict: Bool,
  @len(0, 20) findings: [Finding],
  @range(0, 1) confidence: Float "How sure, from 0 to 1",
  @pattern(r"^[a-z]+$") tag: Str,
  @example("high") severity: Severity,
  counts: Map<Str, Int>,
  span?: (Int, Int),
  raw: Json,
  took: Duration,
  cost: Money,
}

state: { last: Untrusted<Report>?, runs: Int } = { last: none, runs: 0 }

fn ask(p: Prompt) -> Untrusted<Report> {
  model.generate_as::<Report>(p)
}

fn decode(j: Json) -> Untrusted<[Finding]> {
  json.decode::<[Finding]>(j)
}

fn form() -> Prompt {
  prompt {
    instruct "Review."
    format Report
  }
}
