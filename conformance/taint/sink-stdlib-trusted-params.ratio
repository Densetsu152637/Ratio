// Untrusted text cannot reach the trusted parameters of the effectful modules: instructions
// (rubrics, outcomes, options a model must choose from, a new session's prompt, a test
// command), harness and package names, extension sources and names, references and labels.

fn instructions(work: Untrusted<Str>, said: Untrusted<Str>) -> () {
  let c = think.critique(work, said)
  let j = model.judge(work, said)
  let r = think.reflect(work, said)
  let choice = model.choose(work, [said])
  let report = eval.run_tests(said)
  let s = session.start(said)
}

fn names(brief: Untrusted<Str>, which: Untrusted<Str>) -> () {
  let d = agents.delegate(brief, package: which)
  let s = session.start("Carry on.", package: which)
  let v = meta.author(which, brief, "a harness")
  let found = meta.has_harness(which)
}

fn extensions(from: Untrusted<Str>) -> () {
  tools.install_extension(plugin, from)
  tools.activate_plugin(from)
  let skill = tools.load_skill(from)
  let reference = context.load(from)
  eval.label("source", from)
}
