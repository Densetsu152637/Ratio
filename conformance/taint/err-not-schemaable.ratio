// Types that must be schema-able (a `state` type, a `format` type, structured generation and
// decoding) cannot hold handles, functions, prompts or images; schema attributes must fit
// their fields.

state: { conv: Conversation? } = { conv: none }

type Bad = { f: fn(Int) -> Int }

type Refined = {
  @len(1, 3) n: Int,
  @range(0, 10) xs: [Int],
  @pattern(r"^a") count: Int,
  @shiny name: Str,
  @pattern(r"(") unclosed: Str,
}

fn ask(p: Prompt) -> Untrusted<Bad> {
  model.generate_as::<Bad>(p)
}

fn form() -> Prompt {
  prompt {
    instruct "Answer."
    format TrustedPrompt
  }
}

fn decode(j: Json) -> Untrusted<Image> {
  json.decode::<Image>(j)
}
