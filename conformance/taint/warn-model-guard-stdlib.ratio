// The guarded-effect lint over the effectful modules: an install, an authored harness, a
// delegation, a new session, a memory write, a merge and a script, each guarded only by what
// a model said, is shown to a reviewer. An approval from the person is a trusted guard.

type Advice = { install: Bool, source: Str }

fn advice(p: Prompt) -> Untrusted<Advice> {
  model.generate_as::<Advice>(p)
}

fn install_if_told(p: Prompt) -> () {
  let a = advice(p)
  if a.install {
    tools.install_extension(skill, "https://example.com/skills/notes.git")
  }
}

fn act_if_told(p: Prompt, source: Untrusted<Str>, entry: NewMemory, task: Task<Report>) -> () {
  let a = advice(p)
  if a.install {
    let v = meta.author("helper", source, "written on the model's advice")
    let r = agents.delegate(source)
    let s = session.start("Continue the migration.")
    memory.remember(entry)
    let m = agents.merge(task)
    let out = tools.run_script(source)
  }
}

fn install_if_approved(p: Prompt) -> () {
  let a = advice(p)
  if a.install and session.request_approval("Install the notes skill?") {
    tools.install_extension(skill, "https://example.com/skills/notes.git")
  }
}

// Through function values: a closure bound to a local, the same passed to `retry`, and a
// built-in named as a value are still the effects they make.
fn through_values(p: Prompt, source: Untrusted<Str>) -> () {
  let a = advice(p)
  let go = || tools.install_extension(skill, "https://example.com/skills/notes.git")
  let author = meta.author
  if a.install {
    go()
    retry(go)
    let v = author("helper", source, "written through a value")
  }
}

// A function value whose origin is unknown (a parameter) may do anything.
fn through_parameter(p: Prompt, act: fn() -> ()) -> () {
  let a = advice(p)
  if a.install {
    act()
  }
}

// Function values inside lists and records: what each may do counts where the list or record
// is passed, to a built-in or to the program's own function.
fn install() -> () {
  tools.install_extension(skill, "https://example.com/skills/notes.git")
}

fn call_all(fs: [fn() -> ()]) -> () {
  for f in fs {
    f()
  }
}

fn call_box(b: { run: fn() -> () }) -> () {
  let run = b.run
  run()
}

fn inside_values(p: Prompt, q: Untrusted<Str>) -> () {
  let a = advice(p)
  let go = || install()
  let fs = [go]
  let stop_when = |r: Round| {
    install()
    true
  }
  let side = |t: DebateTurn| {
    install()
    t.question
  }
  let referee = |r: DebateRecord| model.judge(text.show(r), "Who argued better?")
  let ok = |n: Int| {
    install()
    true
  }
  if a.install {
    let all = par([go])
    let first = race([go])
    let again = par(fs)
    let either = fallback([go])
    call_all([go])
    call_box({ run: go })
    let it = think.until(0, step: |n| n + 1, stop: { until: stop_when })
    let d = think.debate(q, sides: [side, side], judge: referee)
    let c = think.check(1, [{ name: "installs", run: ok }])
  }
}

// Pipe receivers and generic parameters: a function value passed on the left of `|>`, or for a
// type parameter of a function that may call into its arguments, still counts.
fn invoke(f: fn() -> ()) -> () {
  f()
}

fn each<T>(xs: [T], f: fn(T) -> ()) -> () {
  for x in xs {
    f(x)
  }
}

fn runner(fs: [fn() -> ()]) -> () {
  call_all(fs)
}

fn apply2<T>(x: T, f: fn(T) -> ()) -> () {
  f(x)
}

fn piped_and_generic(p: Prompt) -> () {
  let a = advice(p)
  let go = || install()
  let fs = [go]
  if a.install {
    let r = go |> retry()
    go |> invoke()
    [go] |> call_all()
    let all = fs |> par()
    each([go], invoke)
    apply2([go], runner)
  }
}
