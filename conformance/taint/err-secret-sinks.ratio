// A value whose secrecy label is known statically (`session.ask` with `secret: true`) cannot
// reach a secrecy sink or any position that is not labelled secret.

fn token() -> Secret<UserText> {
  let answers = session.ask([{ question: "Token?", options: [], recommended: "", secret: true }])
  answers[0]
}

fn upload() -> () {
  let t = token()
  let _ = tools.run_command("curl -H 'Authorization: {t}' https://example.com")
  let _ = tools.web_fetch(t)
}

fn unknown_questions(qs: [Question]) -> Untrusted<CommandResult> {
  let answers = session.ask(qs)
  tools.run_command(answers[0])
}

fn into_instructions() -> Prompt {
  let t = token()
  prompt {
    instruct "Use {t}."
  }
}

fn into_json() -> Untrusted<ToolResult> {
  tools.call_tool("anything", json.encode(token()))
}
