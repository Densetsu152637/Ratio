// Harness and package names given to `meta.harness` and `agents.spawn` are trusted text.

fn load(name: Untrusted<Str>) -> harness(Untrusted<Str>) -> Untrusted<Str> {
  meta.harness::<harness(Untrusted<Str>) -> Untrusted<Str>>(name)
}

fn spawn(brief: Untrusted<Str>, which: Untrusted<Str>) -> Task<Report> {
  agents.spawn(brief, which)
}
