// arg: 2.0
// arg: true
// expect: value ["2.0","0.7071067811865476","2.0","1.2909944487358056","none","none"]
// expect: labels secret secret none none none none

fn main(x: Float, b: Bool) -> [Untrusted<Str>] {
  [
    text.show(math.stdev([x, 4.0, 6.0])),
    text.show(math.stdev([1.0, 2.0], sample: b)),
    text.show(math.stdev([2, 4, 4, 4, 5, 5, 7, 9], sample: false)),
    text.show(math.stdev([1, 2, 3, 4])),
    text.show(math.stdev([5.0])),
    text.show(math.stdev(list.take([1.0], 0))),
  ]
}
