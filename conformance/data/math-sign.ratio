// arg: -5
// arg: 0.0
// expect: value ["-1","0","1","0","-1","-1"]
// expect: labels secret secret none none none none

fn main(x: Int, f: Float) -> [Untrusted<Str>] {
  [
    text.show(math.sign(x)),
    text.show(math.sign(f)),
    text.show(math.sign(2.5)),
    text.show(math.sign(math.sqrt(-1.0))),
    text.show(math.sign(0s - 3s)),
    text.show(math.sign(-7)),
  ]
}
