// arg: "7"
// expect: value ["7  ", "700", "7abab", "long", "x"]
// expect: labels secret secret secret none none

fn main(s: Str) -> [Untrusted<Str>] {
  [
    text.show(text.pad_end(s, 3)),
    text.show(text.pad_end(s, 3, fill: "0")),
    text.show(text.pad_end(s, 5, fill: "ab")),
    text.show(text.pad_end("long", 2)),
    text.show(text.pad_end("x", 3, fill: "")),
  ]
}
