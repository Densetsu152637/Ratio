fn main(s: Str) -> [Untrusted<Str>] {
  [
    text.show(codec.base64_decode(s)),
    text.show(codec.base64_decode(s + "!")),
    text.show(codec.base64_decode("Zg")),
    text.show(codec.base64_decode("Zg==")),
    text.show(codec.base64_decode("")),
    text.show(codec.base64_decode("Zh==")),
    text.show(codec.base64_decode("Zg=")),
    text.show(codec.base64_decode("Z")),
    text.show(codec.base64_decode("Zm9v!")),
    text.show(codec.base64_decode("Zm 9v")),
    text.show(codec.base64_decode("/w==")),
    text.show(codec.base64_decode("w6k=")),
    text.show(codec.base64_decode("Zm9vYg==")),
    text.show(codec.base64_decode("Zg==Zg==")),
    text.show(codec.base64_decode("====")),
    text.show(codec.base64_decode("Zm9vYmFy")),
    text.show(codec.base64_decode("_-8=")),
  ]
}
