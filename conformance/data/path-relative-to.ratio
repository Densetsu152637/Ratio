// arg: "/a/b/../c/./d.tar.gz"
// expect: value ["c/d.tar.gz","none","b/c",".","none","none","b","none","c","none","b","none","a","none",".","."]
// expect: labels secret secret none none none none none none none none none none none none none none

fn main(p: Str) -> [Untrusted<Str>] {
  [
    text.show(path.relative_to(p, "/a")),
    text.show(path.relative_to("/a/b", p)),
    text.show(path.relative_to("/a/b/c", "/a")),
    text.show(path.relative_to("/a", "/a")),
    text.show(path.relative_to("/a", "/a/b")),
    text.show(path.relative_to("/x/y", "/a")),
    text.show(path.relative_to("a/b", "a")),
    text.show(path.relative_to("../x", ".")),
    text.show(path.relative_to("/a/b/../c", "/a")),
    text.show(path.relative_to("/a/../b", "/a")),
    text.show(path.relative_to("C:/a/b", "c:/a")),
    text.show(path.relative_to("/a/b", "a")),
    text.show(path.relative_to("../a", "..")),
    text.show(path.relative_to("../../a", "..")),
    text.show(path.relative_to("a/../..", "..")),
    text.show(path.relative_to("/a/b", "/a/b/c/..")),
  ]
}
