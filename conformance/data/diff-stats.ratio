// arg: "a\nb\nc\nd\n"
// arg: "a\nx\nc\nd\ne\n"
// expect: value ["{\"added\":2,\"removed\":1,\"unchanged\":3}","{\"added\":1,\"removed\":1,\"unchanged\":0}","{\"added\":0,\"removed\":0,\"unchanged\":0}","{\"added\":0,\"removed\":0,\"unchanged\":2}","{\"added\":1,\"removed\":2,\"unchanged\":1}","{\"added\":1,\"removed\":0,\"unchanged\":1}","{\"added\":0,\"removed\":4,\"unchanged\":0}"]
// expect: labels secret none none none none none secret

fn main(a: Str, b: Str) -> [Untrusted<Str>] {
  [
    text.show(diff.stats(diff.lines(a, b))),
    text.show(diff.stats(diff.lines("a", "b"))),
    text.show(diff.stats(list.take(diff.lines("a", "a"), 0))),
    text.show(diff.stats(diff.lines("a\nb", "a\nb"))),
    text.show(diff.stats(diff.words("a b c", "a x"))),
    text.show(diff.stats([{ op: equal, text: "x" }, { op: insert, text: "y" }])),
    text.show(diff.stats(diff.lines(a, ""))),
  ]
}
