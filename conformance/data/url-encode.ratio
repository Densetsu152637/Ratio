// arg: "a b"
// expect: value ["a%20b","a%20b%2F%C3%A9~-._","","100%25","a%3Db%26c","%2B","Invalid"]
// expect: labels secret none none none none none none

// The kind of error `f` raises ("ok" when it returns); whether its message was told (the
// Bool carries the message's labels); whether it says `part`.
fn fails<T>(f: fn() -> T) -> Str {
  match result(f) {
    Ok { .. } => "ok",
    Err { error } => if error.kind is Invalid { "Invalid" } else { "other" },
  }
}

fn told<T>(f: fn() -> T) -> Bool {
  match result(f) {
    Ok { .. } => false,
    Err { error } => error.message != "",
  }
}

fn says<T>(f: fn() -> T, part: Str) -> Bool {
  match result(f) {
    Ok { .. } => false,
    Err { error } => text.contains(error.message, part),
  }
}

fn main(s: Str) -> [Untrusted<Str>] {
  [
    url.encode(s),
    url.encode("a b/é~-._"),
    url.encode(""),
    url.encode("100%"),
    url.encode("a=b&c"),
    url.encode("+"),
    fails(|| url.encode(text.repeat("/", 6000000))),
  ]
}
