// arg: 1.0
// expect: value ["1.0","2.0","0.0","0.0","0.0","0.8112781244591328","Invalid","true"]
// expect: labels secret none none none none none none secret

// The kind of error `f` raises ("ok" when it returns); whether its message was told (the
// Bool carries the message's labels); whether it says `part`.
fn fails<T>(f: fn() -> T) -> Str {
  match result(f) {
    Ok { .. } => "ok",
    Err { error } => if error.kind is Invalid { "Invalid" } else { "other" },
  }
}

fn told<T>(f: fn() -> T) -> Bool {
  match result(f) {
    Ok { .. } => false,
    Err { error } => error.message != "",
  }
}

fn says<T>(f: fn() -> T, part: Str) -> Bool {
  match result(f) {
    Ok { .. } => false,
    Err { error } => text.contains(error.message, part),
  }
}

fn main(x: Float) -> [Untrusted<Str>] {
  [
    text.show(math.entropy([x, 1.0])),
    text.show(math.entropy([1.0, 1.0, 1.0, 1.0])),
    text.show(math.entropy([1.0])),
    text.show(math.entropy([0.0, 0.0])),
    text.show(math.entropy(list.take([1.0], 0))),
    text.show(math.entropy([0.25, 0.75])),
    fails(|| math.entropy([1.0, 0.0 - 1.0])),
    text.show(told(|| math.entropy([x, 0.0 - x]))),
  ]
}
