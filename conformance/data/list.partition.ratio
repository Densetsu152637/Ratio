// builtin: list.partition
// case main: value [[2, 4], [1, 3]]
// case empty: value [[], []]
// case raises: error User
// labels partition(xs): [1, 2, 3] ; inner 0
fn main() -> ([Int], [Int]) { list.partition([1, 2, 3, 4], |x| x % 2 == 0) }
fn empty() -> ([Int], [Int]) {
  let xs: [Int] = []
  xs.partition(|x| x > 0)
}
fn raises() -> ([Int], [Int]) { [1].partition(|x| raise fail("boom", "partition")) }
fn partition(xs: [Int]) -> ([Int], [Int]) { list.partition(xs, |x| x > 1) }
