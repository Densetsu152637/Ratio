// builtin: list.filter, list.filter_map, list.flat_map
// case main: value [[2, 4], [20, 40], [1, 1, 2, 2, 3, 3]]
// case raises: error User
// labels filter(xs): [1, 2, 3] ; inner 0
// labels filter_map(xs): [2, 1, 3] ; inner 0
// labels flat_map(xs): [1, 2] ; inner 0
fn main() -> ([Int], [Int], [Int]) {
  let xs = [1, 2, 3, 4]
  (xs.filter(|x| x % 2 == 0), xs.filter_map(|x| if x % 2 == 0 { x * 10 } else { none }), [1, 2, 3].flat_map(|x| [x, x]))
}
fn raises() -> [Int] { [1].filter(|x| raise fail("boom", "filter")) }
fn filter(xs: [Int]) -> [Int] { list.filter(xs, |x| x > 1) }
fn filter_map(xs: [Int]) -> [Int] { list.filter_map(xs, |x| if x > 1 { x } else { none }) }
fn flat_map(xs: [Int]) -> [Int] { list.flat_map(xs, |x| [x, x]) }
