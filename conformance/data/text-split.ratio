// arg: "a,b,,c"
// expect: value ["[\"a\",\"b\",\"\",\"c\"]", "[\"a\",\"b,,c\"]", "Invalid", "true", "Invalid", "[\"x\"]"]
// expect: labels secret secret none secret none none

// The kind of error `f` raises ("ok" when it returns); whether its message was told (the
// Bool carries the message's labels).
fn fails<T>(f: fn() -> T) -> Str {
  match result(f) {
    Ok { .. } => "ok",
    Err { error } => if error.kind is Invalid { "Invalid" } else { "other" },
  }
}

fn told<T>(f: fn() -> T) -> Bool {
  match result(f) {
    Ok { .. } => false,
    Err { error } => error.message != "",
  }
}

fn main(s: Str) -> [Untrusted<Str>] {
  [
    text.show(text.split(s, ",")),
    text.show(text.split(s, ",", limit: 2)),
    text.show(fails(|| text.split(s, ""))),
    text.show(told(|| text.split(s, ""))),
    text.show(fails(|| text.split(s, ",", limit: 0))),
    text.show(text.split("x", ",")),
  ]
}
