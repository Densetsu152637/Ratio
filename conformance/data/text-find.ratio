// arg: "aXbXc"
// expect: value ["1", "3", "none", "0", "2", "2"]
// expect: labels secret secret secret secret none none

fn main(s: Str) -> [Untrusted<Str>] {
  [
    text.show(text.find(s, "X")),
    text.show(text.find(s, "X", from: 2)),
    text.show(text.find(s, "X", from: 4)),
    text.show(text.find(s, "")),
    text.show(text.find("abc", "c", from: -5)),
    text.show(text.find("éaé", "é", from: 1)),
  ]
}
