// arg: 3
// arg: 7
// expect: value ["3","1","3","1","1.0","1.0","1s"]
// expect: labels secret secret secret none none none none

fn main(a: Int, b: Int) -> [Untrusted<Str>] {
  [
    text.show(math.min(a, 9)),
    text.show(math.min(1, b)),
    text.show(math.min(a, b)),
    text.show(math.min(1, 2)),
    text.show(math.min(2.0, 1.0)),
    text.show(math.min(math.sqrt(-1.0), 1.0)),
    text.show(math.min(1s, 2s)),
  ]
}
