// arg: "a1b22c333"
// arg: "(?=x)"
// expect: value ["[\"1\",\"22\",\"333\"]", "[1,3,6]", "2", "[0,1,2]", "Invalid", "true"]
// expect: labels secret secret secret none none secret

// The kind of error `f` raises ("ok" when it returns); whether its message was told (the
// Bool carries the message's labels).
fn fails<T>(f: fn() -> T) -> Str {
  match result(f) {
    Ok { .. } => "ok",
    Err { error } => if error.kind is Invalid { "Invalid" } else { "other" },
  }
}

fn told<T>(f: fn() -> T) -> Bool {
  match result(f) {
    Ok { .. } => false,
    Err { error } => error.message != "",
  }
}

fn main(s: Str, p: Str) -> [Untrusted<Str>] {
  [
    text.show(re.find_all("\\d+", s).map(|m| m.text)),
    text.show(re.find_all("\\d+", s).map(|m| m.start)),
    text.show(re.find_all("\\d+", s, limit: 2).len()),
    text.show(re.find_all("x*", "ab").map(|m| m.start)),
    text.show(fails(|| re.find_all("a", s, limit: -1).len())),
    text.show(told(|| re.find_all(p, s))),
  ]
}
