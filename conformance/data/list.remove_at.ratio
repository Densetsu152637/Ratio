// builtin: list.remove_at
// case main: value [1, 3]
// case last: value [1, 2]
// case out_of_range: error Invalid
// case empty: error Invalid
// labels remove(xs, i): [1, 2, 3] | 1
// labels refused(xs, i): [1, 2, 3] | 3
fn main() -> [Int] { list.remove_at([1, 2, 3], 1) }
fn last() -> [Int] { [1, 2, 3].remove_at(2) }
fn out_of_range() -> [Int] { list.remove_at([1, 2], 2) }
fn empty() -> [Int] {
  let blank: [Int] = []
  list.remove_at(blank, 0)
}
fn remove(xs: [Int], i: Int) -> [Int] { list.remove_at(xs, i) }
fn refused(xs: [Int], i: Int) -> [Int] { list.remove_at(xs, i) }
