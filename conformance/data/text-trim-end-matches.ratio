// arg: "1.00."
// expect: value ["1.00", "1.0", "Invalid", "true"]
// expect: labels secret secret none secret

// The kind of error `f` raises ("ok" when it returns); whether its message was told (the
// Bool carries the message's labels).
fn fails<T>(f: fn() -> T) -> Str {
  match result(f) {
    Ok { .. } => "ok",
    Err { error } => if error.kind is Invalid { "Invalid" } else { "other" },
  }
}

fn told<T>(f: fn() -> T) -> Bool {
  match result(f) {
    Ok { .. } => false,
    Err { error } => error.message != "",
  }
}

fn main(s: Str) -> [Untrusted<Str>] {
  [
    text.show(text.trim_end_matches(s, ".")),
    text.show(text.trim_end_matches(s, "0.")),
    text.show(fails(|| text.trim_end_matches(s, ""))),
    text.show(told(|| text.trim_end_matches(s, ""))),
  ]
}
