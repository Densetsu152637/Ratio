// expect: labels secret none none none none secret

fn main(s: Str) -> [Untrusted<Str>] {
  [
    hash.sha256(s),
    hash.sha256(""),
    hash.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
    hash.sha256("é"),
    hash.sha256(text.repeat("a", 1000)),
    hash.sha256(text.upper(s)),
  ]
}
